# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5300
NODE_ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_STORAGE_BUCKET=pfp-images

# JWT (if needed for future auth)
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Pokhrel Flex Printing <noreply@pokhrelflexprinting.com>  # must be a Resend-verified domain
EMAIL_TO=recipient@example.com                                     # where contact/inquiry/newsletter emails are delivered
EMAIL_LOGO_URL=https://pokhrelflexprinting.com/logo-email.png      # absolute URL to the logo shown in OTP emails

# WhatsApp Cloud API (optional)
WHATSAPP_PHONE_ID=your-whatsapp-phone-id
WHATSAPP_TOKEN=your-whatsapp-permanent-token
WHATSAPP_RECIPIENT=977XXXXXXXXXX

# CORS Origins (comma-separated, leave blank for dev auto-allow)
CORS_ORIGINS=
